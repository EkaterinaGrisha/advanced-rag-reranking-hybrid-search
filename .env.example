# Скопируйте этот файл в .env и укажите свои ключи. Файл .env в репозиторий не добавляется.
# Ключи нужны только для новых запросов к API: при наличии practice_rag/results/ ноутбук воспроизводится без них.
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# оценщик ответов LLM-as-a-Judge (DeepSeek API)
DEEPSEEK_API_KEY=
# проверка доступности модели курса в OpenRouter (п. 1.3)
OPENROUTER_API_KEY=
# необязательно: адрес API GigaChat; по умолчанию https://gigachat.devices.sberbank.ru/api/v1
# GIGACHAT_BASE_URL=
